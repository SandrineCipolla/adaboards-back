generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model test {
  id    Int    @id @default(autoincrement())
  label String
}

model User {
  id         Int          @id @default(autoincrement())
  fullname   String
  email      String       @unique
  password   String
  User_Board User_Board[]
}

model Board {
  id         Int          @id @default(autoincrement())
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  title      String
  Task       Task[]
  User_Board User_Board[]
}

model Task {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  title       String
  description String?
  column      Column @default(TODO)
  boardId     Int
  board       Board    @relation(fields: [boardId], references: [id])
}

model User_Board {
  id      Int    @id @default(autoincrement())
  userId  Int
  boardId Int
  user    User   @relation(fields: [userId], references: [id])
  board   Board  @relation(fields: [boardId], references: [id])
  role    Role
}

enum Column {
    TODO
    DOING
    DONE
}

enum Role {
    OWNER
    READ
    WRITE
}